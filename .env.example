# 镜像站首页；不要把账号、密码、Cookie 或抓包 Token 写入这里。
MIRROR_URL=
# 可选：指定一个已有会话地址；留空则打开 MIRROR_URL。
MIRROR_CHAT_URL=

# 个人本机调试建议 false，浏览器会显示出来，首次可手动登录。
HEADLESS=false
BROWSER_PROFILE_DIR=.browser-profile
IMAGE_DIR=data/generated
REFERENCE_DIR=data/references
DATA_DIR=data
GENERATION_TIMEOUT_SECONDS=180

# 填写后，调用 /api/generate 必须带 X-API-Key；留空表示仅依赖本机访问。
LOCAL_API_KEY=

# 可选：默认生成通道与 OpenAI 兼容生图 API。也可在网页设置中填写。
GENERATION_MODE=mirror
IMAGE_API_NAME=默认 API 节点
IMAGE_API_BASE_URL=
IMAGE_API_PROTOCOL=images
IMAGE_API_MODEL=gpt-image-1
IMAGE_API_KEY=
IMAGE_API_TIMEOUT_SECONDS=240
